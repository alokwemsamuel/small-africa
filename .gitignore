# Dependencies
node_modules/
vendor/

# Environment & secrets
.env
.env.*
!.env.example
!frontend/.env.demo
!frontend/.env.production

# Builds & caches
dist/
build/
coverage/
.vite/
*.log
.phpunit.result.cache
.phpunit.cache/

# Uploads (runtime, outside git)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Runtime storage (keep the folders, never the contents)
backend/storage/logs/*
backend/storage/mail/*
backend/storage/sessions/*
!backend/storage/*/.gitkeep

# Full-size photo downloads (re-fetched by design/tools/build-photos.mjs)
design/photos/originals/

# Generated at build time by frontend/scripts/sitemap.mjs
frontend/public/sitemap.xml
frontend/public/robots.txt
