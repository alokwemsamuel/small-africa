# Copy to .env and fill in. Never commit .env.
APP_ENV=local                     # local | production
APP_DEBUG=false                   # true adds exception details to 500 responses (local only!)
APP_KEY=                          # php bin/generate-key.php
APP_HTTPS=false                   # true in production (adds HSTS)
APP_BASE_PATH=/SmallAfrica/backend/public   # "" when backend/public is the document root
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXIES=                  # comma-separated proxy IPs allowed to set X-Forwarded-For

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=small_africa
DB_USERNAME=small_africa
DB_PASSWORD=
DB_TEST_DATABASE=small_africa_test

SESSION_NAME=sa_session
SESSION_SECURE=false              # true in production (HTTPS only cookie)
SESSION_IDLE_MINUTES=120

MAIL_DRIVER=log                   # log (writes to storage/mail) | smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@smallafrica.ng
MAIL_FROM_NAME="Small Africa"

PAYMENT_DRIVER=simulated          # paystack | simulated (local/tests/demo only; refused in production)
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
